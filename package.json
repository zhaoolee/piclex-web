{
  "name": "piclex-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 18120",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 18120",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "decks:build": "node scripts/build-demo-decks.mjs",
    "mirror:build": "node scripts/build-mirror.mjs",
    "test:deploy": "python3 -B -m unittest discover -s deploy -p \"test_*.py\"",
    "content:build": "node scripts/build-public-content.mjs",
    "test:performance": "node scripts/run-web-performance.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@zip.js/zip.js": "2.24.0",
    "fflate": "0.8.2",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
